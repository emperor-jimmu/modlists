    {
      "id": "20000004",
      "title": "Rotational Power",
      "subtitle": "Harness water to spin shafts",
      "description": [
        "Create's power system is rotational — spinning shafts transfer SU (Stress Units). One water wheel placed in flowing water generates approximately 256 SU. Check stress with Engineer's Goggles."
      ],
