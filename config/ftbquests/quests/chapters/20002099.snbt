    },
    {
      "id": "20002083",
      "title": "Affixed Boss Hunting",
      "subtitle": "Kill Three Bosses with Modifiers",
      "description": [
        "Affixed bosses are your primary Mythic and Epic gear source.",
        "Boss modifiers appear as colored text under the health bar",
        "Common modifiers: Tough (+50 percent HP, significant damage reduction), Blinding (blinds on hit — bring milk or blindness immunity), Plagued (poison and wither on hit — bring antidotes and regeneration), Chaotic (random effect per hit — unpredictable, bring all potion types)",
        "Strategy: Lifesteal rune on weapon for sustain, Ice rune for kiting, fire resistance potions for Plagued bosses",
        "GraveStone preserves your items if you die — the risk is only time."
      ],
      "icon": "minecraft:nether_star",
      "x": 3,
      "y": 3,
      "shape": "hexagon",
      "dependencies": [
        "2000206A"
      ],
