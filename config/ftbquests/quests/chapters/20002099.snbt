    },
    {
      "id": "2000206D",
      "title": "Rarity Colors",
      "subtitle": "White, Yellow, Cyan, Purple, Gold",
      "description": [
        "Border colors indicate rarity at a glance — no need to open the item.",
        "White = Common (0 sockets)",
        "Yellow = Uncommon (1)",
        "Cyan = Rare (2)",
        "Purple = Epic (3)",
        "Gold = Mythic (4)",
        "Scan loot piles for colored glints — your eyes learn to spot Epic purple before your brain processes the item name."
      ],
      "icon": "minecraft:diamond",
      "x": 1.5,
      "y": 0,
      "shape": "square",
      "dependencies": [],
      "tasks": [
        {
          "id": "2000206B",
