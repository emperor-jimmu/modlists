    {
      "id": "20002087",
      "title": "Spawner Engineering",
      "subtitle": "Silk Touch and Customize Spawners",
      "description": [
        "Apotheosis sets spawner Silk Touch requirement to level 1 — any Silk Touch pickaxe mines a spawner intact.",
        "Place it, right-click with empty hand to open the customization GUI",
        "Change: entity type (spawn anything from zombies to endermen), spawn delay (faster equals more mobs), player activation range, minimum and maximum simultaneous entities",
        "Combine with a mob grinder (Mob Grinding Utils or Create saw/drill) for automated XP, loot, and affix gear farming."
      ],
      "icon": "minecraft:spawner",
      "x": 3,
      "y": 4,
