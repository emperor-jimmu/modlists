          "count": 4,
          "reward_table_index": 0
        }
      ],
      "optional": false
    },
    {
      "id": "2000206A",
      "title": "Rarity Climb",
      "subtitle": "Full Uncommon+ Set with Socketed Gems",
      "description": [
        "Phase 1 goal: equip a full set of Uncommon or higher gear with at least one Cut gem socketed in every piece.",
        "Use the Gem Socketing Table",
        "Sockets equal rarity — Uncommon has 1, Rare has 2, etc",
        "Socket expansion tools (found in dungeon chests) can add more sockets",
        "This full Cut-gem Uncommon set is your baseline before tackling Phase 2 bosses and dungeons."
      ],
      "icon": "apotheosis:gem_cutting_table",
      "x": 0,
      "y": 3,
      "shape": "hexagon",
      "dependencies": [
        "20002066"
      ],
