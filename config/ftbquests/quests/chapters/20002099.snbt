          "id": "2000206F",
          "type": "xp_levels",
          "xp_levels": 1
        }
      ],
      "optional": true
    },
    {
      "id": "20002073",
      "title": "Boss Modifiers Primer",
      "subtitle": "Tough, Blinding, Plagued, Chaotic",
      "description": [
        "Starting in Phase 2, bosses spawn with colored modifier names under their health bar.",
        "These are your primary source of Mythic gear — the harder the modifier combination, the better the loot roll",
        "Wait until you have Rare+ gear and a backup weapon before hunting affixed bosses."
      ],
      "icon": "minecraft:wither_skeleton_skull",
      "x": 1.5,
