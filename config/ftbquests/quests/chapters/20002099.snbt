    {
      "id": "2000207B",
      "title": "Library of Alexandria",
      "subtitle": "Infinite Enchanted Book Storage",
      "description": [
        "A single block that stores every enchanted book you will ever own.",
        "Infinite capacity, searchable, and auto-combining — drop two Sharpness IV books in and they automatically merge into one Sharpness V",
        "Dump every enchanted book from mob farms, dungeon chests, and villager trades into the Library",
        "Check periodically — you will discover max-level enchantments you earned without realizing."
      ],
      "icon": "apotheosis:library",
      "x": 3,
      "y": 1,
      "shape": "hexagon",
