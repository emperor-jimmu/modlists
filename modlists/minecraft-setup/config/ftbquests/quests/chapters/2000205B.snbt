    {
      "id": "20002023",
      "title": "Autocrafting Setup",
      "subtitle": "Crafting CPU, Assembler, Provider",
      "description": [
        "Autocrafting infrastructure: Crafting CPU (multiblock — Crafting Storage blocks + Co-Processors in a cuboid shape), Molecular Assemblers (do the actual crafting), Pattern Providers (hold encoded patterns, push items to Assemblers).",
        "Arrange Assemblers in a checkerboard pattern with Pattern Providers — each Assembler touches multiple Providers for maximum recipe coverage.",
        "Tip: Start with a 4-CPU, 4-Co-Processor setup — four simultaneous craft requests with four parallel sub-components each. Scale up when you notice requests queuing."
      ],
