    {
      "id": "20002010",
      "title": "Storage Disks",
      "subtitle": "1K Storage Cell",
      "description": [
        "Storage Cells hold items in the ME Drive.",
        "1K equals 1024 bytes — AE2's storage unit",
        "Each unique item type (not stack count) uses approximately 1 byte",
        "A 1K cell stores roughly 1024 different item types",
        "Upgrade path: 4K to 16K to 64K for exponentially more storage per cell",
        "Store everything — ingots, blocks, tools, food — your ME Drive becomes the single source of truth."
      ],
      "icon": "ae2:1k_storage_cell",
