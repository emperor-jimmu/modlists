== Quests

#mod-entry(
  name: "Starchild-Be-Gone -- Alternative LE3 Ending",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/739",
  game: "LE3",
  version: "v1.6.1",
  last-checked: "2026-07",
  deps: (),
  impact: [Removes the Starchild sequence from Mass Effect 3's ending entirely. The Crucible fires automatically, the Destroy ending plays, and Shepard survives (with the breath scene intact). Includes options for shorter dream sequences and a prologue without the child. Compatible with AHEM and CEM via install options.],
  notes: [Requires LE3 Community Patch and Framework (v1.3+).],
)

== Content

#mod-entry(
  name: "Optional Flirting Mod (LE3)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/608",
  game: "LE3",
  version: "v1.7.6",
  last-checked: "2026-07",
  deps: (),
  impact: [Makes flirting in Mass Effect 3 optional by clearly separating friendly and romantic dialogue choices. Adds interrupt prompts for key romance moments. Prevents accidental romance lock-in.],
  notes: none,
)

#mod-entry(
  name: "Expanded Galaxy Mod (LE)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/422",
  game: "LE3",
  version: "v1.0.6",
  last-checked: "2026-07",
  deps: ("LE3 Community Patch and Framework",),
  impact: [Port of the acclaimed Expanded Galaxy Mod to Mass Effect 3 Legendary Edition. Adds new weapons, improved quality-of-life features, overhauls the Normandy (SR-2), introduces a new war asset system, and much more. Fully modular: choose which modules to install and customise individual options via an in-game settings app.],
  notes: [Modular install. The Normandy Module is required by Miranda Mod. Optional modules include the Squadmate Pack and Galactic War Module for expanded features.],
)

#mod-entry(
  name: "LE3 Diversification Project",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/1174",
  game: "LE3",
  version: "v1.4.1",
  last-checked: "2026-07",
  deps: ("LE3 Community Patch and Framework",),
  impact: [Large-scale immersive overhaul for Mass Effect 3 that diversifies the world through better species population balancing, outfit and appearance diversification for NPCs, and overall breathing more life into the Citadel and hub areas. A companion project to LE1 Diversification Project.],
  notes: none,
)

#mod-entry(
  name: "F.I.S.H. Mod (LE3)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/386",
  game: "LE3",
  version: "v1.4.3",
  last-checked: "2026-07",
  deps: (),
  impact: [Ensures Kelly Chambers will appear at the Citadel refugee camp and return your fish as long as she survived the Suicide Mission in ME2. Flirting with Kelly and inviting her to dinner is no longer required. Dialogue is edited to reflect platonic, flirtatious, or romantic relationship status. Also unlocks the Prejek Paddlefish intel bonus without needing an ME3 NG+.],
  notes: [Compatible with LE3 Community Patch, Conrad No Apology, Kelly Returns, and Optional Flirting Mod. Included in Project Variety. English localisation only for full dialogue edits.],
)

#mod-entry(
  name: "Liara Mourns the Dead",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/1713",
  game: "LE3",
  version: "v1.3.5",
  last-checked: "2026-07",
  deps: (),
  impact: [Expands the conversation between Shepard and Liara that occurs after the Cerberus Coup attempt. This conversation now triggers for all players, not just those meeting specific conditions. Liara discusses Kaidan, Ashley, and/or Thane depending on who died during the Coup and on Virmire.],
  notes: [Compatible with Expanded Galaxy Mod, Project Variety, and LE3 Diversification Project. Thane is excluded from the conversation if he died offscreen after surviving the suicide mission.],
)

#mod-entry(
  name: "Miranda Mod (LE)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/1350",
  game: "LE3",
  version: "v2.0.13",
  last-checked: "2026-07",
  deps: ("Expanded Galaxy Mod (LE) -- Normandy Module", "LE3 Community Patch and Framework"),
  impact: [Puts Miranda back on the Normandy post-Horizon as a full crew member. Features fully voiced conversations including a romance scene, cabin invites, optional squadmate role on Cerberus HQ, Citadel DLC, Leviathan DLC, and Priority: Earth missions, plus a team assignment mini-game. Includes AI-created voice lines for Citadel, Leviathan, and Earth content.],
  notes: [Optional: EGM Squadmate Pack (for full squadmate functionality) and EGM Galactic War Module (for team assignments). English only due to extensive dialogue.],
)

