#mod-entry(
  name: "Charted Worlds (LE1)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/524",
  game: "LE1",
  version: "v1.4",
  last-checked: "2026-07",
  deps: ("ME3Tweaks Mod Manager",),
  impact: [Marks all mineral deposits, points of interest, and Thresher Maw locations on uncharted world maps. Eliminates the need to drive around aimlessly searching for resources. Warning signs indicate probable Thresher Maw locations. Includes built-in compatibility with LE1 Community Patch fixes.],
