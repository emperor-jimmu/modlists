)

== Gameplay and Mechanics

#mod-entry(
  name: "Actual Effort Required (to save the Council)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/2027",
  game: "LE1",
  version: "v1.0",
  last-checked: "2026-07",
  deps: ("LE1 Community Patch",),
  impact: [Reworks the Council rescue decision during the Battle of the Citadel. Saving the Council now requires Shepard to have completed enough UNC assignments and secured reinforcements from Admiral Hackett's fleet. If insufficient missions are completed, the Council dies regardless of the player's choice at the decision point, making your actions throughout the game matter more.],
  notes: none,
)

#mod-entry(
  name: "Alternative Persuasion (LE1)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/1890",
  game: "LE1",
  version: "v1.0",
  last-checked: "2026-07",
  deps: ("ME3Tweaks Mod Manager",),
  impact: [Replaces the vanilla binary Charm/Intimidate threshold system with a probability-based persuasion mechanic. Charm and Intimidate options become dice-roll persuasion checks rather than hard point-gated requirements, allowing more flexible Paragade and Renegon playstyles without penalizing mixed-morality characters.],
  notes: none,
)

#mod-entry(
  name: "Black Market License (LE1)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/661",
  game: "LE1",
  version: "v1.4",
  last-checked: "2026-07",
  deps: ("ME3Tweaks Mod Manager",),
  impact: [Adds a black market requisition terminal to the Normandy SR-1, allowing Shepard to purchase rare and restricted weapons, armor, and equipment throughout the campaign. Expands equipment acquisition options beyond standard vendors.],
  notes: none,
)

== UI and Quality of Life

#mod-entry(
  name: "Galaxy Map Trackers (LE1)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/426",
  game: "LE1",
  version: "v1.3",
  last-checked: "2024-11",
  deps: (),
  impact: [Displays active and undiscovered assignment names directly on the galaxy map in Mass Effect 1. Active assignments use the same name as your journal. Undiscovered assignments are tracked as "Anomaly" so you know where to explore. Compatible with LE1 Community Patch and LE1 Diversification Project.],
  notes: none,
)

#mod-entry(
  name: "Appearance Modification Menu LE1",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/2513",
  game: "LE1",
  version: "v1.1",
  last-checked: "2026-07",
  deps: ("ME3Tweaks Mod Manager",),
