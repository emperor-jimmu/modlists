#mod-entry(
  name: "Elements of Comparative Weaponry (LE1)",
  url: "https://www.nexusmods.com/masseffectlegendaryedition/mods/639",
  game: "LE1",
  version: "v1.1",
  last-checked: "2026-07",
  deps: ("ME3Tweaks Mod Manager",),
  impact: [Replaces the vanilla weapon stat display with more accurate and informative comparative statistics. Adds DPS (burst) and DPS (sustained) values accounting for fire rate, overheating, and cooldown. Replaces the inaccurate vanilla accuracy rating with a composite score based on actual game mechanics. Does NOT modify weapon stats -- display only. Dynamically reflects modded weapon stats.],
