  [Damage Ceiling],
  [22],
  [Highest damage any weapon can have],
  [Weight/Value Scale],
  [1.0],
  [Linear scaling between weight and value],
  [Speed Normalization],
  [ON],
  [Standardizes attack speed ranges per weapon type],
  [Reach Normalization],
