#heading(level: 2)[Events & Decisions]

#heading(level: 3)[#link("https://steamcommunity.com/sharedfiles/filedetails/?id=2712590542")[More Interactive Vassals]]
#block(below: 0.5em)[#text(size: 9pt, fill: rgb("#666666"))[[*Load Order:* Mid | *Essential:* Yes | *Performance:* Minor]]]
