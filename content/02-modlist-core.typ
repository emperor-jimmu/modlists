#heading(level: 2)[Culture & Religion]

#heading(level: 3)[#link("https://steamcommunity.com/sharedfiles/filedetails/?id=2227658180")[VIET Events — A Flavor and Immersion Event Mod]]
#block(below: 0.5em)[#text(size: 9pt, fill: rgb("#666666"))[[*Load Order:* Mid (after RICE) | *Essential:* Yes | *Performance:* Minor]]]
