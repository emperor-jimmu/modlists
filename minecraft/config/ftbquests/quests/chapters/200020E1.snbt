    {
      "id": "200020A7",
      "title": "Oxygen System",
      "subtitle": "Distributor, Water Separator, Solar Panel",
      "description": [
        "Life support loop: Solar Panel generates FE from sunlight — essential on planets where you cannot run Mekanism reactors initially.",
        "Water Separator splits water into oxygen (output) and hydrogen (byproduct)",
        "Oxygen Distributor fills your Space Suit and creates a breathable zone around itself",
        "Chain: Solar Panel powers Water Separator, Separator outputs oxygen, Distributor receives oxygen and refills suit",
        "Build this trio on every planet you visit — without it, every trip is a 10-minute suicide run.",
        "Tip: The Solar Panel works on any planet with a sun — Mercury has the best solar output. On the Moon, orient panels facing the sun direction for maximum FE generation."
      ],
      "icon": "stellaris:oxygen_distributor",
      "x": 0,
      "y": 2,
      "shape": "hexagon",
      "dependencies": [
        "200020A2"
      ],
