    {
      "id": "200020BA",
      "title": "Chunk Loading in Space",
      "subtitle": "Keep Factories Running",
      "description": [
        "Planets in Stellaris are separate Minecraft dimensions.",
        "Your Overworld factories, Mekanism processing lines, and MineColonies STOP when you travel to space",
        "Place a Chunk Loader at every base: Earth (main factory), Moon (mining outpost), Mars (permanent base), Glacio (endgame)",
        "Without chunk loaders, interplanetary logistics fail."
      ],
      "icon": "minecraft:ender_eye",
