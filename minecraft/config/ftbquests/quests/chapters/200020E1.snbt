    {
      "id": "200020B6",
      "title": "Launch Pad Mechanics",
      "subtitle": "Your Return Ticket",
      "description": [
        "Every Launch Pad is a two-way portal.",
        "Land anywhere on a planet, enter the Launch Pad rocket (not your original landing rocket) to return to the linked destination",
        "Multiple Launch Pads on different planets create a fast travel network — Moon pad returns to Earth, Mars pad returns to Moon."
      ],
      "icon": "stellaris:rocket_t1",
