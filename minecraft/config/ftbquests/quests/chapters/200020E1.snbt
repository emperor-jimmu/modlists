  "quests": [
    {
      "id": "2000209D",
      "title": "Space Program",
      "subtitle": "Rocket Station and Fuel Refinery",
      "description": [
        "Rocket Station assembles rocket components — the workbench of space travel.",
        "Fuel Refinery converts oil into rocket fuel",
        "Find oil pools on the surface (dark patches in plains and desert biomes) or underground",
        "Use a Mekanism Pump or TFMG Pump Jack for efficient extraction",
        "Start stockpiling fuel early — a Tier 1 rocket launch consumes approximately 300 units of rocket fuel (produced in the Fuel Refinery from oil).",
        "Tip: Build your Rocket Station near a large body of water — the Water Separator needs water for oxygen, and you will launch dozens of rockets from this location."
      ],
      "icon": "stellaris:rocket_station",
      "x": 0,
      "y": 0,
      "shape": "hexagon",
      "dependencies": [],
